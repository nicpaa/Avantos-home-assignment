# Base URL of the mock server (frontendchallengeserver). Default assumes `npm start` on port 3000.
VITE_API_BASE_URL=http://localhost:3000

# Path params for action-blueprint-graph-get. The mock server ignores them,
# but they stay configurable so the same client works against a real backend.
VITE_TENANT_ID=1
VITE_BLUEPRINT_ID=bp_01jk766tckfwx84xjcxazggzyc

# Prefill data sources offered in the modal, comma-separated, in display order.
# Empty or unset = all of them. Valid ids: direct-dependencies, transitive-dependencies, global-data
# Example: VITE_DATA_SOURCES=global-data,direct-dependencies
VITE_DATA_SOURCES=
